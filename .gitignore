# CMake / IDE

.idea*/
.vs
.venv
.claude/

CMakeLists.txt.user
CMakeCache.txt
CMakeFiles
CMakeScripts
Testing
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps
.ninja_deps
.ninja_log

# Out-of-tree build dirs.
# Agents invent names (build-asan, build-cov, build-apx21, …); cover them all.
# Prefer a single canonical `build/` for local and CI work.
/build/
/build-*/
/cmake-build-*/
/out/
# Also match non-root names used historically
build
cmake-build-*/

# Object files, static libs, shared libs (even if built in-tree by mistake)
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb

# Vendored DXC runtime binaries must stay tracked (build-output dlls are
# ignored above, but thirdparty/dxc/bin/* is checked-in source).
!thirdparty/dxc/bin/win-x64/dxcompiler.dll
!thirdparty/dxc/bin/macOS/libdxcompiler.dylib
!thirdparty/dxc/bin/linux-x64/libdxcompiler.so
!thirdparty/dxc/bin/linux-x64/libdxil.so

#skore
*.pak
# Never commit offline apt packages or extracted sysroot workarounds
*.deb
.deb-cache/
.deps/
# C# bindings are generated into the CMake binary dir, never the source tree
Dotnet/SkoreEngine/Generated/

#android
# Gradle files
.gradle/
build/
libVkLayer_khronos_validation.so

# Local configuration file (sdk path, etc)
local.properties

# External native build folder generated in Android Studio 2.2 and later
externalNativeBuild/
.cxx/

# NDK
obj/
